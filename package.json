{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "_moduleAliases": {
    "@shared": "dist/shared",
    "@backend": "dist"
  },
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node -P tsconfig.json -r tsconfig-paths/register src/index.ts",
    "build": "npm run build:clean && npm run build:compile",
    "build:clean": "rimraf dist",
    "build:compile": "tsc -P tsconfig.json",
    "start": "node -r module-alias/register dist/index.js",
    "seed": "ts-node -P tsconfig.json -r tsconfig-paths/register src/scripts/import-all-csvs.ts",
    "db:init": "ts-node -P tsconfig.json -r tsconfig-paths/register src/scripts/init-db.ts",
    "db:seed": "ts-node -P tsconfig.json -r tsconfig-paths/register src/scripts/import-all-csvs.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.7.1",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@heroicons/react": "^2.2.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-levenshtein": "^3.0.0",
    "framer-motion": "^7.6.16",
    "multer": "^2.0.2",
    "openai": "^6.16.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf-poppler": "^0.2.3",
    "pdf2json": "^4.0.1",
    "pdfjs-dist": "^5.4.530",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.5",
    "zod-to-json-schema": "^3.25.1",
    "zustand": "^5.0.9",
    "module-alias": "^2.2.3"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/node-fetch": "^2.6.13",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "rimraf": "^6.0.1"
  }
}
