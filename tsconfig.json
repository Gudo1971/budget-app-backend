{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": "src",
    "paths": {
      "@shared/*": ["shared/*"],
      "@backend/*": ["*"]
    }
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
