{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "..",

    "rootDirs": ["src", "../shared"],

    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"],
      "@backend/*": ["backend/src/*"]
    }
  },

  "include": ["src", "../shared"],

  "exclude": ["node_modules", "dist"]
}
