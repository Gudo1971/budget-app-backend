{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    "paths": {
      "@shared/*": ["../frontend/src/shared/*"]
    }
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
